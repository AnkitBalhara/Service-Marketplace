{
  "info": {
    "name": "MarketPulse Services Marketplace API",
    "description": "Comprehensive Postman collection covering Authentication, Catalogue, Derived Slots, Bookings with Concurrency Locks, Mock Payments, and Admin Governance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (SuperAdmin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@marketplace.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Customer 1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@marketplace.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Me (Profile & Permissions)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Catalogue & Slots",
      "item": [
        {
          "name": "Get Categories (2-Level Hierarchy)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/catalogue/categories", "host": ["{{baseUrl}}"], "path": ["catalogue", "categories"] }
          }
        },
        {
          "name": "Search Published Services (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/catalogue/services?page=1&limit=10&query=",
              "host": ["{{baseUrl}}"],
              "path": ["catalogue", "services"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "query", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Derive Real-time Slots",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/availability/services/{{serviceId}}/slots?offeringId={{offeringId}}&startDate=2026-08-26&endDate=2026-08-30",
              "host": ["{{baseUrl}}"],
              "path": ["availability", "services", "{{serviceId}}", "slots"],
              "query": [
                { "key": "offeringId", "value": "{{offeringId}}" },
                { "key": "startDate", "value": "2026-08-26" },
                { "key": "endDate", "value": "2026-08-30" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking (PAY_NOW tok_success)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "idem_{{$timestamp}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"offeringId\": \"{{offeringId}}\",\n  \"date\": \"2026-08-28\",\n  \"startTime\": \"10:30\",\n  \"paymentMode\": \"PAY_NOW\",\n  \"paymentToken\": \"tok_success\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Reschedule Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-08-29\",\n  \"startTime\": \"11:15\",\n  \"reason\": \"Schedule adjustment\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/reschedule", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "reschedule"] }
          }
        },
        {
          "name": "Cancel Booking (With Refund)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer requested cancellation\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/metrics", "host": ["{{baseUrl}}"], "path": ["admin", "metrics"] }
          }
        },
        {
          "name": "List All Bookings (Cross-Vendor)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/bookings?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["admin", "bookings"] }
          }
        },
        {
          "name": "Approve Vendor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/vendors/{{vendorId}}/approve", "host": ["{{baseUrl}}"], "path": ["admin", "vendors", "{{vendorId}}", "approve"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" }
  ]
}
