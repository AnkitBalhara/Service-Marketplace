{
  "name": "services-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Three-sided services marketplace (Customer, Vendor, Admin)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "seed": "npm run seed --workspace=apps/api",
    "test": "npm run test:suite --workspace=apps/api && npm run test:concurrency --workspace=apps/api",
    "test:suite": "npm run test:suite --workspace=apps/api",
    "test:concurrency": "npm run test:concurrency --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
