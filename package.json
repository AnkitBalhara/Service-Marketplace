{
  "name": "services-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Three-sided services marketplace (Customer, Vendor, Admin)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "test": "npm run test:suite --workspace=backend && npm run test:concurrency --workspace=backend",
    "test:suite": "npm run test:suite --workspace=backend",
    "test:concurrency": "npm run test:concurrency --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
