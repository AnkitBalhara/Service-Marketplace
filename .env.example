# ==============================================
# Marketplace Configuration (Example Template)
# ==============================================

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection URI)
# For local MongoDB: mongodb://127.0.0.1:27017/marketplace
# For MongoDB Atlas / Cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/marketplace
MONGODB_URI=mongodb://127.0.0.1:27017/marketplace

# Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Business Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
FREE_CANCELLATION_WINDOW_HOURS=24
